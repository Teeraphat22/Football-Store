# Supabase (Get these from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Keep this secret! Used for admin actions in Server only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (Get these from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (Get this from Resend Dashboard)
RESEND_API_KEY=re_...

# App URL (For redirects and webhooks, usually http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
